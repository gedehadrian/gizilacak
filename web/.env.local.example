# Salin file ini jadi .env.local dan isi dengan kredensial project Supabase kamu
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
# Ambang batas waktu konsumsi default (jam) - bisa dioverride per batch di database
NEXT_PUBLIC_DEFAULT_AMBANG_JAM=4
# PIN admin demo (server-side saja — jangan pakai NEXT_PUBLIC_)
ADMIN_PIN=2468
