# Salin file ini jadi .env.local dan isi dengan kredensial project Supabase kamu

# Publik (aman di-bundle ke browser) — dipakai hanya untuk hal non-sensitif.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
NEXT_PUBLIC_DEFAULT_AMBANG_JAM=4

# SERVER-ONLY — JANGAN PERNAH diberi prefix NEXT_PUBLIC_, jangan di-commit,
# jangan ditempel di chat/dokumen manapun. Ambil dari Supabase Dashboard >
# Project Settings > API > service_role secret. Key ini membypass RLS.
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# PIN login dashboard admin/BGN (demo). Wajib diisi — tidak ada nilai default,
# supaya tidak ada PIN "bawaan" yang bisa ditebak dari dokumentasi publik.
ADMIN_PIN=

# String acak minimal 32 karakter untuk menandatangani cookie session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Header rahasia untuk mengizinkan POST /api/seed (seed data demo satu kali).
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SEED_SECRET=
